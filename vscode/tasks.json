{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tuna: Open Project in Finder",
            "type": "process",
            "command": "/usr/bin/python3",
            "args": [
                "${env:HOME}/Library/Application Support/Tuna/scripts/open_here.py",
                "finder",
                "--folder",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "close": true
            }
        },
        {
            "label": "Tuna: Open Project in Ghostty",
