#!/bin/sh

dir_path=$(/usr/bin/osascript <<'APPLESCRIPT'
tell application "System Events"
	set frontApp to name of first application process whose frontmost is true
end tell

if frontApp is "Ghostty" then
	tell application "/Applications/Ghostty.app"
		set currentTerm to focused terminal of selected tab of front window
		set dirPath to working directory of currentTerm
	end tell
else if frontApp is "Finder" then
	tell application "/System/Library/CoreServices/Finder.app"
		if (count of selection) > 0 then
			set selectedItem to item 1 of selection
			if class of selectedItem is folder then
				set finderDir to selectedItem as alias
			else
				set finderDir to container of selectedItem as alias
			end if
		else if (count of windows) > 0 then
			set finderDir to target of front window as alias
		else
			set finderDir to POSIX file "/Users/luke/Desktop/" as alias
		end if
	end tell

	set dirPath to POSIX path of finderDir
else
	set dirPath to "/Users/luke/"
end if

return dirPath
APPLESCRIPT
)

if [ -z "$dir_path" ]; then
	exit 1
fi

exec /opt/homebrew/bin/code -n "$dir_path"
